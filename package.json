{
  "name": "quorum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:content": "vitest run src/content/content.test.ts",
    "build": "npm run typecheck && npm run validate:content && vite build",
    "check": "npm run typecheck && npm test && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "preview:deploy": "npm run check && wrangler preview",
    "deploy": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vitest": "3.2.4",
    "wrangler": "4.147.0"
  }
}
